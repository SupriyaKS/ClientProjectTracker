@model List<ClientProjectTracker.Models.TaskItem>

@{
    ViewData["Title"] = "Kanban Board";
}

<h2 class="mb-4">Task Kanban Board</h2>

<div class="row">

    <!-- Pending -->
    <div class="col-md-4">

        <div class="card bg-light shadow-sm">

            <div class="card-header">
                <h5>Pending</h5>
            </div>

            <div class="card-body" id="Pending">

                @foreach (var task in Model.Where(t => t.Status == "Pending"))
                {
                    <div class="card mb-3 shadow-sm task-card" data-id="@task.Id">

                        <div class="card-body">

                            <h6>@task.Title</h6>

                            <small class="text-muted">
                                @task.Project?.Name
                            </small>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>

    <!-- In Progress -->
    <div class="col-md-4">

        <div class="card bg-light shadow-sm">

            <div class="card-header">
                <h5>In Progress</h5>
            </div>

            <div class="card-body" id="InProgress">

                @foreach (var task in Model.Where(t => t.Status == "In Progress"))
                {
                    <div class="card mb-3 shadow-sm task-card" data-id="@task.Id">

                        <div class="card-body">

                            <h6>@task.Title</h6>

                            <small class="text-muted">
                                @task.Project?.Name
                            </small>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>

    <!-- Completed -->
    <div class="col-md-4">

        <div class="card bg-light shadow-sm">

            <div class="card-header">
                <h5>Completed</h5>
            </div>

            <div class="card-body" id="Completed">

                @foreach (var task in Model.Where(t => t.Status == "Completed"))
                {
                    <div class="card mb-3 shadow-sm border-success task-card" data-id="@task.Id">

                        <div class="card-body">

                            <h6>@task.Title</h6>

                            <small class="text-muted">
                                @task.Project?.Name
                            </small>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>

</div>
@section Scripts {

<script>

    document.addEventListener("DOMContentLoaded", function () {

    const columns = [

        "Pending",

        "InProgress",

        "Completed"

    ];

    columns.forEach(column => {

        const element = document.getElementById(column);

        if (!element)

            return;

        new Sortable(element, {

            group: "tasks",

            animation: 150,

            onEnd: async function (evt) {

                const taskId = evt.item.dataset.id;

                let newStatus = evt.to.id;

                if (newStatus === "InProgress") {

                    newStatus = "In Progress";

                }

                const response = await fetch(`/api/tasks/${taskId}/status`, {

                    method: "PUT",

                    headers: {

                        "Content-Type": "application/json"

                    },

                    body: JSON.stringify({

                        status: newStatus

                    })

                });

                if (!response.ok) {

                    alert("Failed to update task.");

                }

            }

        });

    });

});

</script>

}