<h2>Projects</h2>

<a asp-action="Create" asp-route-clientId="@ViewBag.ClientId" class="btn btn-primary">
    Add Project
</a>

<table class="table">
    <tr>
        <th>Name</th>
        <th>Description</th>
    </tr>

@foreach (var p in Model)
{
    <tr>
        <td>@p.Name</td>
        <td>@p.Description</td>
        <td>
            <a asp-controller="Tasks"
            asp-action="Index"
            asp-route-projectId="@p.Id"
            class="btn btn-warning btn-sm">
            View Tasks
            </a>
        </td>
    </tr>
}
</table>

